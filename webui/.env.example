# Copy to `.env` (gitignored) and fill in your IPTV provider details.
#
#   cp .env.example .env
#
# This app is Xtream Codes compatible. Point it at YOUR provider:

# Credentials + provider hosts:
IPTV_USERNAME=
IPTV_PASSWORD=
IPTV_LOGIN_URL=http://your-provider.example.com   # host serving player_api.php
IPTV_SERVER=your-stream-host.example.com           # host serving the streams
# IPTV_PORT=80

# Alternative to the above: read credentials from a desktop IPTV app's
# localStorage (it must store an Xtream "profile"). Point this at the file —
# example macOS path shown:
# IPTV_LS_DB=/Users/you/Library/Application Support/<YourIPTVApp>/Local Storage/file__0.localstorage

# Optional tuning:
# PORT=8090
# CACHE_TTL=21600       # catalogue cache lifetime, seconds (6h)
# ACCOUNT_TTL=15        # account/profile cache lifetime, seconds
# VOD_CACHE_TTL=21600   # film catalogue cache lifetime, seconds (6h)
# VOD_INFO_TTL=3600     # per-film metadata cache lifetime, seconds (1h)
# EPG_TTL=600           # catch-up guide cache lifetime, seconds (10m)
# FFMPEG_PATH=ffmpeg    # used to remux MKV/AVI films; unset = look on PATH
# FFPROBE_PATH=ffprobe  # used to detect whether a film's audio needs converting
# WORLDCUP_TTL=30       # World Cup data cache lifetime, seconds
