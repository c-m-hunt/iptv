# Copy to `.env` (gitignored) and fill in your IPTV provider details.
#
#   cp .env.example .env
#
# This app is Xtream Codes compatible. Point it at YOUR provider.
#
# These same settings can live in webui/config.json instead — see
# config.example.json. Precedence: environment variables > .env > config.json.

# --- credentials (option 1: set them here) ---------------------------------
IPTV_USERNAME=
IPTV_PASSWORD=
IPTV_LOGIN_URL=http://your-provider.example.com   # host serving player_api.php
IPTV_SERVER=your-stream-host.example.com          # host serving the streams
# IPTV_PORT=80

# --- credentials (option 2: read them from a desktop IPTV app) -------------
# The app must store an Xtream "profile" in localStorage. Requires the sqlite3
# CLI. Whichever of the two options is set first wins.
# IPTV_LS_DB=/Users/you/Library/Application Support/<YourIPTVApp>/Local Storage/file__0.localstorage

# --- server ----------------------------------------------------------------
# PORT=8090
# HOST=0.0.0.0          # 0.0.0.0 so phones and other machines on the LAN can reach it
# CACHE_DIR=            # catalogue cache location; defaults to ~/.cache/iptv

# --- caching ---------------------------------------------------------------
# CACHE_TTL=21600        # live channel catalogue, seconds (6h)
# VOD_CACHE_TTL=21600    # film catalogue, seconds (6h)
# VOD_INFO_TTL=3600      # per-film metadata, seconds (1h)
# VOD_PROBE_TTL=86400    # container sniff results, seconds (24h)
# SERIES_CACHE_TTL=21600 # series catalogue, seconds (6h)
# SERIES_INFO_TTL=3600   # per-show seasons/episodes, seconds (1h)
# EPG_TTL=600            # catch-up guide, seconds (10m)
# ACCOUNT_TTL=15         # profile/subscription, seconds — short, it reports live connections
# POSTER_CACHE_MB=32     # in-memory artwork cache; the provider's CDN is unreliable

# --- playback --------------------------------------------------------------
# IPTV_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20   # some portals reject unknown clients
# FFMPEG_PATH=ffmpeg     # remuxes MKV/AVI films and episodes; unset = look on PATH
# FFPROBE_PATH=ffprobe   # detects whether a file's audio needs converting
# REMUX_AUDIO_BITRATE=192k  # audio produced when a file's own audio isn't AAC
# REMUX_AUDIO_CHANNELS=2    # 2 downmixes 5.1 to stereo; 6 keeps surround

# --- phone remote ----------------------------------------------------------
# REMOTE_HOST=          # address the phone should use. Needed in Docker, where the
                        # container's own IPs are no use to a phone — set it to the
                        # host machine's LAN address.
# REMOTE_PORT=          # port the phone should use. Needed when the published port
                        # differs from the one we bind, as it does in Docker.
# REMOTE_PAIR_TTL=600   # seconds a pairing QR stays valid before it's first used
