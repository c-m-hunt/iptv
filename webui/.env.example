# Copy to `.env` and fill in to override credentials instead of mounting the
# IPTV app localStorage file. Env vars take precedence over the mounted file.
#
#   cp .env.example .env
#
IPTV_USERNAME=
IPTV_PASSWORD=
# Optional — these have sensible invictusdedi.com defaults:
# IPTV_LOGIN_URL=http://invictusdedi.com
# IPTV_SERVER=x1.invictusdedi.com
# IPTV_PORT=80

# Optional tuning:
# PORT=8090
# CACHE_TTL=21600       # catalogue cache lifetime, seconds (6h)
# WORLDCUP_TTL=30       # World Cup data cache lifetime, seconds
